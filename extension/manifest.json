{
  "manifest_version": 3,
  "name": "Privacy-Preserving Browser Agent (PBA)",
  "version": "0.3.0",
  "description": "On-device visual perception + PII redaction. The browser is the privacy gatekeeper; only sanitized context leaves the machine.",

  "minimum_chrome_version": "121",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "sidePanel",
    "clipboardWrite"
  ],

  "host_permissions": ["<all_urls>", "http://*/*", "https://*/*", "file:///*"],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_title": "Privacy Browser Agent"
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "lib/protocol.js",
        "lib/privacy/pii-regex.js",
        "lib/privacy/dom-detector.js",
        "lib/privacy/fusion.js",
        "lib/privacy/policy.js",
        "lib/redactor.js",
        "lib/dom-perception.js",
        "lib/record-extraction.js",
        "lib/task-parser.js",
        "lib/goal-manager.js",
        "lib/world-state.js",
        "lib/state-sync.js",
        "lib/element-registry.js",
        "lib/multimodal-grounding.js",
        "lib/content-executor.js",
        "lib/post-condition.js",
        "lib/recovery-engine.js",
        "lib/local-secret-handler.js",
        "lib/privacy/see-gate.js",
        "lib/privacy/do-gate.js",
        "lib/privacy/egress-gate.js",
        "content/content.js"
      ],
      "css": ["content/overlay.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["lib/vision/*", "models/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
